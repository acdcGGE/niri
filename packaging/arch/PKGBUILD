# Maintainer: Yuri <yuri@localhost>
# LoongArch port build. Upstream niri is not packaged in the Arch repos.
# Builds fetch crates and the smithay git snapshot from the network; set
# CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse and a mirror in ~/.cargo/config.toml
# if crates.io is unreachable (this machine uses rsproxy.cn).
# The binary is intentionally not stripped: niri's release profile carries
# debug="line-tables-only" so that panic backtraces keep file/line info.
pkgname=niri
pkgver=26.4.0+loong64
pkgrel=1
pkgdesc="Scrollable-tiling Wayland compositor (LoongArch port)"
arch=('loong64')
url="https://github.com/niri-wm/niri"
license=('GPL-3.0-or-later')
depends=('cairo' 'gcc-libs' 'glibc' 'libdisplay-info' 'libgbm' 'libglvnd' 'libinput'
         'libpipewire' 'libseat' 'libxkbcommon' 'pango' 'systemd-libs' 'wayland' 'mesa')
optdepends=('xwayland-satellite: run X11 applications'
            'xdg-desktop-portal-gnome: screencasting'
            'xdg-desktop-portal-gtk: fallback portal'
            'gnome-keyring: Secret portal provider'
            'gnome-control-center: global shortcuts portal'
            'mako: notification daemon used by the default config')
makedepends=('cargo' 'rust' 'clang' 'pkgconf' 'git')
options=('!lto' '!strip')
source=("$pkgname-$pkgver.tar.gz::https://github.com/acdcGGE/niri/archive/7f81a7f77b0e93464645232bd15ba2dc43ca3782.tar.gz")
sha256sums=('2b8dea40120806954901397fe700e587b505db3d233735644828b75454f085dc')

build() {
  cd "niri-7f81a7f77b0e93464645232bd15ba2dc43ca3782"
  export NIRI_BUILD_COMMIT=7f81a7f
  export CARGO_PROFILE_RELEASE_LTO=off
  export CARGO_NET_GIT_FETCH_WITH_CLI=true
  cargo build --release --locked --bin niri
}

package() {
  cd "niri-7f81a7f77b0e93464645232bd15ba2dc43ca3782"
  install -Dm755 target/release/niri "$pkgdir/usr/bin/niri"
  install -Dm755 resources/niri-session "$pkgdir/usr/bin/niri-session"
  install -Dm644 resources/niri.desktop "$pkgdir/usr/share/wayland-sessions/niri.desktop"
  install -Dm644 resources/niri-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/niri-portals.conf"
  install -Dm644 resources/niri.service "$pkgdir/usr/lib/systemd/user/niri.service"
  install -Dm644 resources/niri-shutdown.target "$pkgdir/usr/lib/systemd/user/niri-shutdown.target"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/niri/LICENSE"
  "$pkgdir/usr/bin/niri" completions bash > "$pkgdir/usr/share/bash-completion/completions/niri"
  "$pkgdir/usr/bin/niri" completions zsh > "$pkgdir/usr/share/zsh/site-functions/_niri"
  "$pkgdir/usr/bin/niri" completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/niri.fish"
}
